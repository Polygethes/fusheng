# 本项目不内置默认模型。人物模型来源按以下顺序解析：
#   1. GTOWN_MODEL_TRANSPORT 显式指定（model-api | subagent | codex-cli | none）
#   2. 操作者提供的 API：必须同时给出 key 与 CHARACTER_TOWN_MODEL，缺一不可
#   3. 当前所处的 agent 外壳（Claude Code / Codex CLI / Cursor 等）→ subagent 触发
#   4. 都没有 → 不调用任何模型，只跑确定性推演
# 只给 key 不给 model 不再自动推断模型名：那会让人在不知情的情况下计费，
# 并把一个从未选择过的模型写进运行来源记录。
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
CHARACTER_TOWN_MODEL=deepseek-v4-flash
# API 通道下各人物是彼此独立的无状态请求，可并发；同一人物自身的阶段仍严格串行。
# GTOWN_MODEL_MAX_CONCURRENT_CHARACTERS=4
# 在 agent 外壳中运行时，每个阶段写到这个目录，由外壳的 subagent 作答。
# GTOWN_V27_SUBAGENT_EXCHANGE=/tmp/gtown-subagent-exchange
# GTOWN_AGENT_SHELL=none   # 关闭外壳探测
# 结构化人物阶段默认关闭 DeepSeek 隐式思考，确保最终 JSON 写入 content；仅在验证过完整兼容性后改为 enabled。
# CHARACTER_TOWN_DEEPSEEK_THINKING=disabled
CHARACTER_TOWN_MODEL_MODE=auto
CHARACTER_TOWN_PIPELINE_MODE=balanced
# 可选值: fast | balanced | live | quality。live=模型逐轮生成对白（自然度最高、调用最多）
# CHARACTER_TOWN_LIVE_TURN_MODEL=deepseek-v4  # 可选：仅 live 回合台词使用的强模型；不设则用 CHARACTER_TOWN_MODEL
CHARACTER_TOWN_API_STYLE=chat

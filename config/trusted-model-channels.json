{
  "schemaVersion": 2,
  "defaultChannelId": "openai-codex-chatgpt",
  "channels": [
    {
      "id": "openai-codex-chatgpt",
      "provider": "openai",
      "transport": "codex-cli",
      "authentication": "saved-chatgpt-login",
      "allowedPurposes": [
        "character-foundation-blind-probe",
        "tavern-character-agent-behavior-acceptance"
      ],
      "allowedModels": [
        "gpt-5.6-sol",
        "gpt-5.6-luna"
      ],
      "defaultModel": "gpt-5.6-sol",
      "defaultReasoningEffort": "medium",
      "allowedPurposesByModel": {
        "gpt-5.6-sol": [
          "character-foundation-blind-probe",
          "tavern-character-agent-behavior-acceptance"
        ],
        "gpt-5.6-luna": [
          "tavern-character-agent-behavior-acceptance"
        ]
      },
      "allowedReasoningEffortsByModel": {
        "gpt-5.6-sol": [
          "low",
          "medium",
          "high"
        ],
        "gpt-5.6-luna": [
          "medium",
          "high",
          "max"
        ]
      }
    }
  ]
}
